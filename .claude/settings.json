{
  "autoCompactWindow": 300000,
  "enabledPlugins": {
    "context-mode@context-mode": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/compactaciones.sh\""
          }
        ]
      }
    ]
  }
}
